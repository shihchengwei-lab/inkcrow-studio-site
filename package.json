{
  "name": "inkcrow-studio-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/normalize-export.mjs",
    "start": "npm run preview --",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm test && npm run test:browser",
    "test:browser": "npm run build && playwright test",
    "test:browser:install": "playwright install chromium"
  },
  "dependencies": {
    "marked": "^18.0.5",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "playwright": "1.62.1",
    "typescript": "^5"
  }
}
